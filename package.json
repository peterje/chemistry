{
  "name": "alchemy-agent",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "build": "vite build && rm -rf .tanstack src/.tanstack",
    "preview": "vite preview",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "RUN_LIVE_E2E=1 bun test test/live.e2e.test.ts",
    "test:browser": "playwright test",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-rc.110",
    "@effect/platform-bun": "4.0.0-rc.110",
    "@effect/platform-node": "4.0.0-rc.110",
    "@tanstack/react-router": "1.167.4",
    "@tanstack/react-start": "1.166.15",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-rc.110",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.62.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.35.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vite": "8.0.7"
  },
  "overrides": {
    "@effect/platform-browser": "4.0.0-rc.110",
    "effect": "4.0.0-rc.110"
  }
}

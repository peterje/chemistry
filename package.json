{
  "name": "chemistry",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "build": "bun run typecheck && cd apps/website && bun run build",
    "preview": "cd apps/website && bun run preview",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "ci:provision": "alchemy deploy stacks/github.ts --profile admin --stage infrastructure",
    "prepare": "lefthook install",
    "lint": "bun --bun oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "RUN_LIVE_E2E=1 bun test apps/backend/test/live.e2e.test.ts",
    "test:browser": "playwright test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@chemistry/agent-runtime": "workspace:*",
    "@chemistry/backend": "workspace:*",
    "@chemistry/chat-catalog": "workspace:*",
    "@chemistry/client-runtime": "workspace:*",
    "@chemistry/contracts": "workspace:*",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-rc.110"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.62.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "lefthook": "2.1.10",
    "oxfmt": "0.35.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vite": "8.0.7"
  },
  "overrides": {
    "@effect/platform-browser": "4.0.0-rc.110",
    "effect": "4.0.0-rc.110"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
